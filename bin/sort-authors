#!/usr/bin/env python
# /// script
# requirements = [
#   "ruamel.yaml",
# ]
# ///
"""
This is a script to help us keep our "blog/authors.yml" file alphabetically sorted.
"""

import pathlib
from io import StringIO

import ruamel.yaml as yaml

#: Directory where blog posts are located
AUTHORS_FILE = pathlib.Path("./blog/authors.yml")


def main():
    # match .pre-commit-config.yaml yamlfmt args:
    # --mapping=2 --offset=2 --sequence=4 --width=1000000 --implicit_start
    parser = yaml.YAML()
    parser.indent(mapping=2, offset=2, sequence=4)
    parser.width = 1000000
    parser.explicit_start = False
    parser.explicit_end = False
    parser.preserve_quotes = False

    # load authors file and sort
    authors = parser.load(AUTHORS_FILE.read_text())
    authors = {author: meta for author, meta in sorted(authors.items())}

    # dump authors to string
    stream = StringIO()
    parser.dump(authors, stream)

    # save authors file
    AUTHORS_FILE.write_text(stream.getvalue())


if __name__ == "__main__":
    main()

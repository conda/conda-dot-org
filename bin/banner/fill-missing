#!/usr/bin/env bash
# Generates banners for any blog post(s) whose frontmatter requests one
# (`image:`) but whose target file doesn't exist yet. Used as a pre-commit
# hook (see .pre-commit-config.yaml) and can also be run manually.
set -euo pipefail

HERE=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )

cd "${HERE}"
npm install --silent
node banner.js fill-missing "$@"
